#!/usr/bin/env bash
# drsg-shell-guard — a Claude Code PreToolUse hook (matcher: Bash), installed
# by `drsg init` and pointed at from the repository's .claude/settings.local.json.
#
# A repository that ran `drsg init` has its graph and its source tree attached
# to the drsg-watch MCP server, whose verbs read and search them: grep (text,
# regex, path scope, context lines — each hit placed in its symbol), snippet
# (a symbol's body, or any file's line range), context (what a symbol is and
# who calls it), search (by meaning), recall (the code as it was at any commit).
# Given both, an agent still reaches for `rg`, `sed -n` or `git show <rev>:<path>`
# out of habit; this hook meets that habit at the moment of
# the call and names the verb that answers instead. It is a redirect, not a
# wall: a leading `DRSG_RAW=<reason>` runs the command untouched, and naming
# the reason — `git`, `notcode`, `mine`, `logs`, `lag` — is the whole of its
# cost. Bare `DRSG_RAW=1` is there for the case none of those names.
#
# Blocks by the documented protocol — exit 2, the reason on stderr, which the
# host feeds back to the model. Anything it cannot parse it lets through: a
# hook that fails closed would cost far more than the habit it exists to break.
set -u

# How many reasonless hatch uses pass before the verbs are reprinted once. Two
# is the floor: the nag resets the tally, so the retry it promises must pass.
NAG_EVERY=${DRSG_NAG_EVERY:-25}
case "$NAG_EVERY" in '' | *[!0-9]*) NAG_EVERY=25 ;; esac
[ "$NAG_EVERY" -lt 2 ] && NAG_EVERY=2

INPUT=$(cat)
if command -v jq >/dev/null 2>&1; then
  CMD=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
elif command -v python3 >/dev/null 2>&1; then
  CMD=$(printf '%s' "$INPUT" | python3 -c 'import json,sys
try:
    print((json.load(sys.stdin).get("tool_input") or {}).get("command", ""))
except Exception:
    pass' 2>/dev/null)
else
  exit 0
fi
[ -z "${CMD:-}" ] && exit 0

# Where this session's reasonless-hatch tally lives — one agent's count is not
# another's. Falls back to $PPID when the payload carries no session id.
tally_path() {
  local id=""
  if command -v jq >/dev/null 2>&1; then
    id=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
  elif command -v python3 >/dev/null 2>&1; then
    id=$(printf '%s' "$INPUT" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("session_id") or "")
except Exception:
    pass' 2>/dev/null)
  fi
  id=${id//[^A-Za-z0-9._-]/}
  printf '%s/drsg-guard-%s.count' "${TMPDIR:-/tmp}" "${id:-$PPID}"
}

# A redirection or a heredoc is a write, not a read — `cat > file <<EOF`.
# Judged on the command with its quoted and escaped text removed: `rg '>'`
# and `grep "a -> b"` are searches whose *pattern* holds an arrow, and a
# guard that let every such pattern through was a guard with a hole in it.
# A stderr redirect (`2>/dev/null`) is not a write either.
bare=$(printf '%s' "$CMD" | sed -E \
  -e 's/"([^"\\]|\\.)*"//g' \
  -e "s/'[^']*'//g" \
  -e 's/\\.//g' \
  -e 's/[0-9]>//g')
case "$bare" in *'>'*|*'<<'*) exit 0 ;; esac

# The first word of the first command: past leading env assignments and an
# `rtk` prefix, up to whitespace or a pipe.
first=$(printf '%s' "$CMD" | sed -E \
  -e 's/^[[:space:]]*//' \
  -e 's/^([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*//' \
  -e 's/^rtk[[:space:]]+//' \
  -e 's/^([^[:space:]|;&]+).*/\1/')
first=${first##*/}

case "$first" in
  rg|grep|egrep|fgrep|ugrep|ug|ag|ack|cat|head|tail|less|more|bat) ;;
  sed) case "$CMD" in *'sed -n'*|*'sed -En'*) ;; *) exit 0 ;; esac ;;
  git)
    case "$CMD" in
      *'git show '*:*|*'git grep'*|*'git log'*' -p'*|*'git log'*' --patch'*|*'git log'*' -L'*) ;;
      *) exit 0 ;;
    esac ;;
  *) exit 0 ;;
esac

# The escape hatch, read only where a shell would read one: a leading env
# assignment on the command being judged, quoted text already stripped. A
# `DRSG_RAW=1` in a pattern, an argument or a trailing comment is text being
# searched for, and honouring it made grepping for the hatch a way of turning
# the guard off.
lead=$(printf '%s' "$bare" | sed -E \
  -e 's/^[[:space:]]*//' \
  -e 's/^(([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*).*/\1/')
#
# A named reason passes unremarked — stating why the shell is right here is the
# judgement this hook wants made, and that is all it asks. A reasonless one
# passes too, but is counted: every NAG_EVERY uses the verbs are printed once
# and the tally reset, so the immediate retry always goes through. Silence was
# what let the prefix stop being the exception.
case "$lead" in
  *DRSG_RAW=git[[:space:]]* | *DRSG_RAW=notcode[[:space:]]* | \
  *DRSG_RAW=mine[[:space:]]* | *DRSG_RAW=logs[[:space:]]* | \
  *DRSG_RAW=lag[[:space:]]*) exit 0 ;;
  *DRSG_RAW=*)
    tally=$(tally_path)
    n=0
    [ -r "$tally" ] && read -r n <"$tally" 2>/dev/null
    case "$n" in '' | *[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    if [ "$n" -lt "$NAG_EVERY" ]; then
      printf '%s' "$n" >"$tally" 2>/dev/null || true
      exit 0
    fi
    printf '0' >"$tally" 2>/dev/null || true
    cat >&2 <<MSG
drsg: that is $NAG_EVERY shell reads past the graph this session, every one of
them prefixed DRSG_RAW=1. The prefix is cheaper to type than the routing
decision is to make, which is how it stops being the exception. The verbs
again:
  context(name)      what a symbol is, who calls it, what it calls — one call
  impact(name)       what breaks if it changes, before editing it
  snippet(name | path:start-end)           its source
  grep(pattern, path?, regex?, context?)   text; each hit names its symbol
  search(query)      by meaning when no name is known
  recall(name, at)   the code as it was at a revision
Re-run the command exactly as it stands and it goes through. If the shell is
genuinely the tool here, name which in the prefix instead and this will not
ask: DRSG_RAW=notcode / =git / =mine / =logs / =lag <command>
MSG
    exit 2 ;;
esac

cat >&2 <<'MSG'
drsg: this repository's graph and source tree are attached to the drsg-watch MCP server, which reads and searches them — use its tools instead of the shell:
  grep(pattern, path?, regex?, context?)   find text; each hit names the symbol it is in
  snippet(name | path:start-end)            a symbol's body, or a range of any file
  context(name)                             what a symbol is, who calls it, what it calls
  search(query)                             find by meaning when no name is known
  recall(name | pattern, at, vs?)           code as it was at a revision: a file, a symbol, a search, a diff
When the shell really is the tool here, name which in the prefix and it passes unremarked:
  DRSG_RAW=notcode <command>   docs, config, markdown, shell — nothing a plane parses
  DRSG_RAW=git <command>       what a commit carried, a rebase, the index — history, not the tree
  DRSG_RAW=mine <command>      my own logs and scratch files, not this repository's code
  DRSG_RAW=logs <command>      program output, not source
  DRSG_RAW=lag <command>       a file this session has edited, read to edit it again
  DRSG_RAW=1 <command>         the case none of those names
MSG
exit 2
