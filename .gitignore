/target

# Local database files created by drsg / just serve, including the native
# LSM engine's on-disk sidecars (HNSW vector index, BM25 keyword index).
*.drsg
*.drsg.jsonl
*.drsg.hnsw
*.drsg.bm25

# Runtime logs from dr-strange-log (DRSG_LOG_DIR, default ./logs) — the server
# writes ./logs relative to its cwd, so ignore the dir anywhere.
logs/

# CodeGraph's local symbol index — a machine-local cache rebuilt from source.
.codegraph/

# Local MCP server registrations — carries a bearer token for a `serve watch`
# instance bound to an ephemeral, machine-local port. Never share or commit.
# Cursor is a desktop app, launched with no shell environment to read a token
# out of, so its config carries the token itself; `drsg init` writes both.
.mcp.json
.cursor/mcp.json

# Local agent working notes (coverage baseline, conventions) — per machine.
/CLAUDE.md

# The official plugins live in their own repository (`dr-strange-extensions`),
# checked out here so the two can be worked on together. Its history is its
# own: a plugin ships a fix without waiting for a database release.
extensions/

# `just gate-hooks` runs the hook's unittest module in place, and CPython
# caches beside the source it imports.
__pycache__/
